{
  "name": "playdragon",
  "productName": "PlayDragon",
  "version": "1.1.0",
  "description": "Jeu 3D : un dragon survole une vallée au coucher du soleil et doit détruire le château au bout du chemin.",
  "author": "Raphael Mounir",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "start:desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.1.1",
    "electron-updater": "6.3.9",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "com.raphaelmounir.playdragon",
    "productName": "PlayDragon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "PlayDragon-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlayDragon"
    },
    "portable": {
      "artifactName": "PlayDragon.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "raphaelmounirprivate-dot",
      "repo": "PlayDragon"
    }
  },
  "allowScripts": {
    "electron@33.3.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
